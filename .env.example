# SWFL Compass: Docker configuration. Copy to `.env` and fill in your keys:
#   cp .env.example .env
# docker compose reads .env automatically. Never commit the real .env.

# Required: Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: Google Maps key with "Places API (New)" enabled.
# Without it the app still works; it just skips verified places and map pins.
GOOGLE_MAPS_API_KEY=

# Optional overrides
# APP_PORT=8080
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACKS=gemini-3-flash-preview,gemini-3.5-flash-lite
